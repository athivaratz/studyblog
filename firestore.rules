rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Users collection - user can only access their own data
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // User Stats - user can only access their own stats
    match /userStats/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // User Settings - user can only access their own settings
    match /userSettings/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // Subjects - user can only access their own subjects
    match /subjects/{subjectId} {
      allow list: if isAuthenticated();
      allow get: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Homework - user can only access their own homework
    match /homework/{homeworkId} {
      allow list: if isAuthenticated();
      allow get: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Todos - user can only access their own todos
    match /todos/{todoId} {
      allow list: if isAuthenticated();
      allow get: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Schedule - user can only access their own schedule
    match /schedules/{scheduleId} {
      allow list: if isAuthenticated();
      allow get: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Flashcards - user can only access their own flashcards
    match /flashcards/{flashcardId} {
      allow list: if isAuthenticated();
      allow get: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Review Sessions - user can only access their own sessions
    match /reviewSessions/{sessionId} {
      allow list: if isAuthenticated();
      allow get: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
