rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    // Helper function to check if the resource belongs to the user
    function isResourceOwner() {
      return resource.data.userId == request.auth.uid;
    }

    // =====================
    // USER DATA
    // =====================
    
    // Users collection - user profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update, delete: if isOwner(userId);
    }
    
    // User stats
    match /userStats/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // User settings
    match /userSettings/{userId} {
      allow read, write: if isOwner(userId);
    }

    // =====================
    // SUBJECTS
    // =====================
    match /subjects/{subjectId} {
      allow read: if isAuthenticated() && isResourceOwner();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && isResourceOwner();
    }

    // =====================
    // HOMEWORK
    // =====================
    match /homework/{homeworkId} {
      allow read: if isAuthenticated() && isResourceOwner();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && isResourceOwner();
    }

    // =====================
    // TODOS
    // =====================
    match /todos/{todoId} {
      allow read: if isAuthenticated() && isResourceOwner();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && isResourceOwner();
    }

    // =====================
    // SCHEDULE
    // =====================
    match /schedules/{scheduleId} {
      allow read: if isAuthenticated() && isResourceOwner();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && isResourceOwner();
    }

    // =====================
    // FLASHCARDS & REVIEW
    // =====================
    match /flashcards/{flashcardId} {
      allow read: if isAuthenticated() && isResourceOwner();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && isResourceOwner();
    }
    
    match /reviewSessions/{sessionId} {
      allow read: if isAuthenticated() && isResourceOwner();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && isResourceOwner();
    }

    // =====================
    // QUIZ QUESTIONS
    // =====================
    match /quizQuestions/{questionId} {
      allow read: if isAuthenticated() && isResourceOwner();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && isResourceOwner();
    }

    // =====================
    // QUIZ SETS
    // =====================
    match /quizSets/{setId} {
      allow read: if isAuthenticated() && isResourceOwner();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && isResourceOwner();
    }

    // =====================
    // QUIZ BANKS (for portal)
    // =====================
    match /quizBanks/{bankId} {
      // Public quizzes can be read by anyone authenticated
      allow read: if isAuthenticated() && 
        (isResourceOwner() || resource.data.isPublic == true);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && isResourceOwner();
    }

    // =====================
    // SHARED QUIZZES (public sharing)
    // =====================
    match /sharedQuizzes/{quizId} {
      // Anyone can read shared quizzes by share code
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
      // Owner can update anything; others can only increment playCount
      allow update: if isAuthenticated() && 
        (resource.data.createdBy == request.auth.uid || 
         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playCount'])));
      allow delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
    }

    // =====================
    // TAGS
    // =====================
    match /tags/{tagId} {
      allow read: if isAuthenticated() && isResourceOwner();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && isResourceOwner();
    }

    // =====================
    // NOTES
    // =====================
    match /notes/{noteId} {
      allow read: if isAuthenticated() && isResourceOwner();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && isResourceOwner();
    }

    // =====================
    // STUDY GOALS
    // =====================
    match /studyGoals/{goalId} {
      allow read: if isAuthenticated() && isResourceOwner();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && isResourceOwner();
    }

    // =====================
    // STUDY SESSIONS
    // =====================
    match /studySessions/{sessionId} {
      allow read: if isAuthenticated() && isResourceOwner();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && isResourceOwner();
    }

    // =====================
    // DAILY STATS
    // =====================
    match /dailyStats/{statsId} {
      allow read: if isAuthenticated() && 
        (statsId.matches(request.auth.uid + '_.*') || resource.data.userId == request.auth.uid);
      allow create, update: if isAuthenticated() && 
        (statsId.matches(request.auth.uid + '_.*') || request.resource.data.userId == request.auth.uid);
      allow delete: if isAuthenticated() && 
        statsId.matches(request.auth.uid + '_.*');
    }

    // =====================
    // PUBLIC QUIZ PORTAL
    // =====================
    match /publicQuizzes/{quizId} {
      // Anyone authenticated can read public quizzes
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
    }
  }
}
